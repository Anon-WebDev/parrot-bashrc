rm -f "$HOME/.bashrc"

cat > "$HOME/.bashrc" <<'EOF'
# ~/.bashrc: executed by bash(1) for non-login shells.

# If not running interactively, don't do anything.
[ -z "$PS1" ] && return


# ============================================================
# HISTORY
# ============================================================

HISTCONTROL=ignoredups:ignorespace
shopt -s histappend

HISTSIZE=1000
HISTFILESIZE=2000

shopt -s checkwinsize


# ============================================================
# LESSPIPE
# ============================================================

[ -x /usr/bin/lesspipe ] && eval "$(SHELL=/bin/sh lesspipe)"


# ============================================================
# DEBIAN CHROOT
# ============================================================

if [ -z "$debian_chroot" ] && [ -r /etc/debian_chroot ]; then
    debian_chroot=$(cat /etc/debian_chroot)
fi


# ============================================================
# TERMINAL COLOR SUPPORT
# ============================================================

case "$TERM" in
    xterm-color|*-256color)
        color_prompt=yes
        ;;
esac

force_color_prompt=yes

if [ -n "$force_color_prompt" ]; then
    if [ -x /usr/bin/tput ] && tput setaf 1 >&/dev/null; then
        color_prompt=yes
    else
        color_prompt=
    fi
fi


# ============================================================
# CUSTOM MULTI-COLOR TERMINAL PROMPT
#
# COLOR VARIATION #4
#
# Border / Symbols = Bright Yellow
# Username         = Bright Red
# @                = Bright Cyan
# Hostname         = Bright White
# Path             = Bright Blue
# Prompt $ / #     = Bright Green
# Error ✗          = Bright Magenta
#
#
# NORMAL:
#
# ┌──[james@server]─[~/project]
# └──╼ $
#
#
# AFTER FAILED COMMAND:
#
# ┌──[✗]──[james@server]─[~/project]
# └──╼ $
#
# ============================================================

if [ "$color_prompt" = yes ]; then

    PS1='\[\e[1;93m\]┌──$([[ $? != 0 ]] && echo "[\[\e[1;95m\]✗\[\e[1;93m\]]──")[\[\e[1;91m\]\u\[\e[1;96m\]@\[\e[1;97m\]\h\[\e[1;93m\]]─[\[\e[1;94m\]\w\[\e[1;93m\]]\n└──╼ \[\e[1;92m\]\$\[\e[0m\] '

else

    PS1='\u@\h:\w\$ '

fi

unset color_prompt
unset force_color_prompt


# ============================================================
# TERMINAL TITLE
# ============================================================

case "$TERM" in
    xterm*|rxvt*)
        PROMPT_COMMAND='printf "\033]0;%s@%s: %s\007" "$USER" "${HOSTNAME%%.*}" "${PWD/#$HOME/~}"'
        ;;
    *)
        ;;
esac


# ============================================================
# COLORED COMMAND OUTPUT
# ============================================================

if [ -x /usr/bin/dircolors ]; then

    if [ -r "$HOME/.dircolors" ]; then
        eval "$(dircolors -b "$HOME/.dircolors")"
    else
        eval "$(dircolors -b)"
    fi

    alias ls='ls --color=auto'
    alias grep='grep --color=auto'
    alias fgrep='fgrep --color=auto'
    alias egrep='egrep --color=auto'

fi


# ============================================================
# LS ALIASES
# ============================================================

alias ll='ls -alF'
alias la='ls -A'
alias l='ls -CF'


# ============================================================
# NAVIGATION ALIASES
# ============================================================

alias ..='cd ..'
alias ...='cd ../..'
alias ....='cd ../../..'


# ============================================================
# SYSTEM ALIASES
# ============================================================

alias cls='clear'

alias mkdir='mkdir -pv'

alias df='df -h'
alias free='free -h'

alias ports='sudo ss -tulpn'

alias update='sudo apt update && sudo apt upgrade'

alias reloadbash='source "$HOME/.bashrc"'


# ============================================================
# NETWORK ALIASES
# ============================================================

alias ipinfo='ip -br addr'

alias routes='ip route'

alias listening='sudo ss -tulpn'


# ============================================================
# PROCESS ALIASES
# ============================================================

alias psg='ps aux | grep -i'

alias mem='free -h'

alias disk='df -h'


# ============================================================
# ALERT ALIAS
# ============================================================

alias alert='notify-send --urgency=low -i "$([ $? = 0 ] && echo terminal || echo error)" "$(history | tail -n1 | sed -e '\''s/^\s*[0-9]\+\s*//;s/[;&|]\s*alert$//'\'')"'


# ============================================================
# CUSTOM USER ALIASES
# ============================================================

if [ -f "$HOME/.bash_aliases" ]; then
    . "$HOME/.bash_aliases"
fi


# ============================================================
# BASH COMPLETION
# ============================================================

if [ -f /etc/bash_completion ] && ! shopt -oq posix; then

    . /etc/bash_completion

elif [ -f /usr/share/bash-completion/bash_completion ]; then

    . /usr/share/bash-completion/bash_completion

fi


# ============================================================
# NVM / NODE.JS
# ============================================================

export NVM_DIR="$HOME/.nvm"

if [ -s "$NVM_DIR/nvm.sh" ]; then
    . "$NVM_DIR/nvm.sh"
fi

if [ -s "$NVM_DIR/bash_completion" ]; then
    . "$NVM_DIR/bash_completion"
fi


# ============================================================
# PATH
# ============================================================

export PATH="$PATH:/usr/local/bin:$HOME/.local/bin"


# ============================================================
# DEFAULT EDITOR
# ============================================================

if command -v nano >/dev/null 2>&1; then
    export EDITOR=nano
    export VISUAL=nano
fi


# ============================================================
# END ~/.bashrc
# ============================================================
EOF

source "$HOME/.bashrc"
